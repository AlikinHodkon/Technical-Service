										]
									}
								}
							]
						},
						{
							"name": "2. Create an open request for it",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"equipmentId\": \"{{deletionEquipmentId}}\",\n  \"title\": \"Проверить перед списанием\",\n  \"priority\": \"low\"\n}"
								},
								"url": { "raw": "{{baseUrl}}/requests", "host": ["{{baseUrl}}"], "path": ["requests"] }
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test('status 201', () => pm.response.to.have.status(201));",
											"pm.collectionVariables.set('deletionRequestId', pm.response.json().id);"
										]
									}
								}
							]
						},
						{
							"name": "3. DELETE equipment while request is open (409)",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": { "raw": "{{baseUrl}}/equipment/{{deletionEquipmentId}}", "host": ["{{baseUrl}}"], "path": ["equipment", "{{deletionEquipmentId}}"] }
							},
							"event": [
								{ "listen": "test", "script": { "exec": ["pm.test('status 409', () => pm.response.to.have.status(409));"] } }
							]
						},
						{
							"name": "4. Close the request",
							"request": {
								"method": "PATCH",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": { "mode": "raw", "raw": "{\n  \"status\": \"rejected\"\n}" },
								"url": { "raw": "{{baseUrl}}/requests/{{deletionRequestId}}/status", "host": ["{{baseUrl}}"], "path": ["requests", "{{deletionRequestId}}", "status"] }
							},
							"event": [
								{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }
							]
						},
						{
							"name": "5. DELETE equipment now succeeds (204)",
							"request": {
								"method": "DELETE",
								"header": [],
								"url": { "raw": "{{baseUrl}}/equipment/{{deletionEquipmentId}}", "host": ["{{baseUrl}}"], "path": ["equipment", "{{deletionEquipmentId}}"] }
							},
							"event": [
								{ "listen": "test", "script": { "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"] } }
							]
						}
					]
				}
			]
		},
