									"pm.test('scoped to this equipment only', () => {",
									"    const json = pm.response.json();",
									"    json.data.forEach((r) => pm.expect(r.equipmentId).to.eql(pm.collectionVariables.get('equipmentId')));",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "PATCH /requests/:id/status — close before delete",
					"request": {
						"method": "PATCH",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": { "mode": "raw", "raw": "{\n  \"status\": \"done\"\n}" },
						"url": { "raw": "{{baseUrl}}/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}", "status"] }
					},
					"event": [
						{ "listen": "test", "script": { "exec": ["pm.test('status 200', () => pm.response.to.have.status(200));"] } }
					]
				},
				{
					"name": "DELETE /requests/:id — success (204)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["requests", "{{requestId}}"] }
					},
					"event": [
						{ "listen": "test", "script": { "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"] } }
					]
				},
				{
					"name": "DELETE /requests/:id — unknown id (404)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/requests/unknown-id", "host": ["{{baseUrl}}"], "path": ["requests", "unknown-id"] }
					},
					"event": [
						{ "listen": "test", "script": { "exec": ["pm.test('status 404', () => pm.response.to.have.status(404));"] } }
					]
				},
				{
					"name": "DELETE /equipment/:id — final cleanup (204)",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": { "raw": "{{baseUrl}}/equipment/{{equipmentId}}", "host": ["{{baseUrl}}"], "path": ["equipment", "{{equipmentId}}"] }
					},
					"event": [
						{ "listen": "test", "script": { "exec": ["pm.test('status 204', () => pm.response.to.have.status(204));"] } }
					]
				}
			]
		},
		{
			"name": "Security",
			"item": [
				{
					"name": "GET /health — burst until rate limited (429)",
					"request": {
						"method": "GET",
						"header": [],
						"description": "Намеренно превышает RATE_LIMIT_MAX для /api (по умолчанию 100 запросов / 60с в .env). Скрипт повторяет сам себя (postman.setNextRequest), пока не получит 429, затем останавливается. ВАЖНО: после срабатывания сервер будет отвечать 429 на все запросы к /api до конца текущего окна — поэтому папка стоит последней в коллекции; подождите ~RATE_LIMIT_WINDOW_MS перед повторным прогоном всей коллекции.",
						"url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const MAX_ATTEMPTS = 120;",
									"const attempts = parseInt(pm.collectionVariables.get('rateLimitAttempts') || '0', 10) + 1;",
									"pm.collectionVariables.set('rateLimitAttempts', String(attempts));",
									"",
									"if (pm.response.code === 429) {",
									"    pm.test('status 429 once the rate limit is exceeded', () => {",
									"        pm.response.to.have.status(429);",
									"    });",
									"    pm.test('rate limit headers present', () => {",
									"        pm.expect(pm.response.headers.has('RateLimit-Limit')).to.be.true;",
									"        pm.expect(pm.response.headers.has('RateLimit-Remaining')).to.be.true;",
									"    });",
									"    pm.test('unified error shape', () => {",
									"        const json = pm.response.json();",
									"        pm.expect(json.status).to.eql(429);",
									"        pm.expect(json.requestId).to.be.a('string');",
									"    });",
									"    pm.collectionVariables.set('rateLimitAttempts', '0');",
									"} else if (attempts < MAX_ATTEMPTS) {",
									"    pm.execution.setNextRequest('GET /health — burst until rate limited (429)');",
									"} else {",
									"    pm.test('rate limit triggers within ' + MAX_ATTEMPTS + ' requests', () => {",
									"        pm.expect(pm.response.code).to.eql(429);",
									"    });",
									"    pm.collectionVariables.set('rateLimitAttempts', '0');",
									"}"
								]
							}
						}
					]
				}
			]
		}
	]
}
