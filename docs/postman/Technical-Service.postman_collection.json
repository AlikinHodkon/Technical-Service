				{
					"name": "DELETE /equipment/:id — blocked by open request (409)",
					"item": [
						{
							"name": "1. Create equipment for deletion test",
							"request": {
								"method": "POST",
								"header": [{ "key": "Content-Type", "value": "application/json" }],
								"body": {
									"mode": "raw",
									"raw": "{\n  \"name\": \"Оборудование под удаление\",\n  \"type\": \"sensor\",\n  \"serialNumber\": \"WT-POSTMAN-DEL-0001\",\n  \"location\": { \"lat\": 50, \"lon\": 30 },\n  \"status\": \"operational\",\n  \"installedAt\": \"2024-01-01T00:00:00.000Z\"\n}"
								},
								"url": { "raw": "{{baseUrl}}/equipment", "host": ["{{baseUrl}}"], "path": ["equipment"] }
							},
							"event": [
								{
									"listen": "test",
									"script": {
										"exec": [
											"pm.test('status 201', () => pm.response.to.have.status(201));",
