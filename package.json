{
	"name": "technical-service",
	"version": "1.0.0",
	"type": "module",
	"main": "src/server.ts",
	"scripts": {
		"start": "tsx --env-file=.env src/server.ts",
		"dev": "tsx --env-file=.env --watch src/server.ts",
		"db:migrate": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate",
		"db:migrate:undo": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate:undo",
		"db:migrate:undo:all": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:migrate:undo:all",
		"db:seed": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:seed:all",
		"db:seed:undo:all": "node --env-file=.env node_modules/sequelize-cli/lib/sequelize db:seed:undo:all",
		"db:migrate-legacy": "tsx --env-file=.env scripts/migrate-legacy-data.ts",
		"test": "node --env-file=.env --env-file=.env.test node_modules/vitest/vitest.mjs run",
		"test:watch": "node --env-file=.env --env-file=.env.test node_modules/vitest/vitest.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check",
		"format": "biome check --write",
		"prepare": "lefthook install"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": "",
	"dependencies": {
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"express": "^5.2.1",
		"express-rate-limit": "^8.7.0",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.3",
		"pg": "^8.23.0",
		"pg-hstore": "^2.3.4",
		"pino": "^10.3.1",
		"pino-http": "^11.0.0",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"sequelize": "^6.37.8",
		"sequelize-cli": "^6.6.5",
		"sequelize-typescript": "^2.1.6",
		"swagger-ui-express": "^5.0.1",
		"tsx": "^4.23.13",
		"zod": "^4.6.5",
		"zod-openapi": "^6.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.6.1",
		"@types/supertest": "^7.2.1",
		"@types/swagger-ui-express": "^4.1.8",
		"@types/validator": "^13.15.10",
		"lefthook": "^2.1.14",
		"pino-pretty": "^13.1.3",
		"supertest": "^7.2.2",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
